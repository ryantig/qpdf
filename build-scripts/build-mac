#!/bin/bash
set -ex
cd $(dirname $0)/..
# # cmake -S . -B build -DCI_MODE=1 -DCMAKE_BUILD_TYPE=Release
# # cmake --build build --verbose -j$(sysctl -n hw.ncpu) -- -k
# -Wall -Wextra
export CFLAGS="-O2 -flto -march=native -mtune=native -ftrapv -fstack-protector-all -Wshadow -Wstrict-overflow=5 -pedantic"
export CXXFLAGS="-O2 -flto -march=native -mtune=native -ftrapv -fstack-protector-all -Wshadow -Wstrict-overflow=5 -pedantic"

export LDFLAGS="-flto"
# non default test case enablement:
# export QPDF_TEST_COMPARE_IMAGES=1
if cmake -S . -B build -DZOPFLI=1 -DCI_MODE=1 -DCMAKE_BUILD_TYPE=Release; then
  if cmake --build build --verbose -j6 -- -k; then
# (cd build; ctest --verbose)
    if ! cd build; then
      echo "cd build failed. exiting."
      exit 1
    fi
    #ctest --verbose
  fi
fi
